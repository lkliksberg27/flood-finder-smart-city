NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token-here
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Long random string. Required to call POST /api/seed, which WIPES all
# readings and flood events and regenerates demo data. Never set this in
# production; seeding is refused there regardless.
SEED_SECRET=

# Long random string. Required to call POST /api/auth/setup, which creates
# a confirmed dashboard account. Unset it once your account exists.
ADMIN_SETUP_SECRET=
